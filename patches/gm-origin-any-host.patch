+// originSameHost reports whether origin points at exactly the host serving the
+// request (scheme may differ, port must match). The GM console is published
+// behind a reverse proxy on an arbitrary host/port, so pinning publicOrigin to a
+// single literal value breaks every other entry point; comparing against the
+// live Host keeps the CSRF guard (cross-site origins still fail) while allowing
+// any domain or port to be used without touching service.json.
+func originSameHost(origin, host string) bool {
+	u, err := url.Parse(origin)
+	if err != nil || u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" {
+		return false
+	}
+	if u.Scheme != "https" && u.Scheme != "http" {
+		return false
+	}
+	return u.Host != "" && u.Host == host
+}
